{
  "name": "@bwnd/bbot",
  "version": "0.2.0",
  "description": "A small, friendly animated face for web pages. Eyes that follow your cursor, 30 moods, 9 reactions. 3.7 kB, no dependencies.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/face.js",
  "exports": {
    ".": "./dist/face.js",
    "./react": "./dist/react.js",
    "./face.css": "./dist/face.css",
    "./core": "./src/core.js",
    "./expressions": "./src/expressions.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs",
    "demo": "npx --yes http-server . -p 8080 -c-1"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "keywords": [
    "face",
    "eyes",
    "svg",
    "animation",
    "cursor",
    "mouse",
    "avatar",
    "mascot",
    "spring",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bwndapp/bbot.git"
  },
  "homepage": "https://bbot.bwnd.app"
}
